# -----------------------------------------------------
# CUSTOMIZATION
# -----------------------------------------------------

# -----------------------------------------------------
# Set-up FZF key bindings (CTRL R for fuzzy history finder)
# -----------------------------------------------------
source <(fzf --zsh)

# zsh history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory

# -----------------------------------------------------
# Prompt
# -----------------------------------------------------

# ohmyposh Theme
eval "$(oh-my-posh init zsh --config /usr/share/oh-my-posh/themes/catppuccin_macchiato.omp.json)"
#eval "$(oh-my-posh init zsh --config /usr/share/oh-my-posh/themes/catppuccin_frappe.omp.json)"


eval "$(zoxide init --cmd cd zsh)"

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=5'
#ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=value'