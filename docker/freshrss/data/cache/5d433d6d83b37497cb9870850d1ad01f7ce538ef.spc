<p><a>Sha-Boom &#x2013; </a><a href="https://youtu.be/aAUsnjkL66U?list=PLlDSHbediJYxTTQqDqgUQl8YrO6lp_7pv&amp;ref=heavyblogisheavy.com">Another Nail In The Coffin</a> (rock)</p><p><a>Static Abyss &#x2013; </a><a href="https://peaceville.bandcamp.com/album/the-dying-hunt?ref=heavyblogisheavy.com">The Dying Hunt</a> (death doom)</p><p><a>Steve Hackett &amp; Steve Rothery &#x2013; </a><a href="https://insideoutmusic.bandcamp.com/album/the-roaring-waves-24-bit-hd-audio?ref=heavyblogisheavy.com">The Roaring Waves</a> (post prog)</p><p><a>Sunscorched &#x2013; </a><a href="https://sunscorched.bandcamp.com/album/blood-of-the-badlands?ref=heavyblogisheavy.com">Blood Of The Badlands</a> (meloblack)</p><p>Svorght &#x2013; <a href="https://svorght.bandcamp.com/album/svart-lerret?from=search&amp;search_item_id=2661923157&amp;search_item_type=a&amp;search_match_part=%3F&amp;search_page_id=5687989646&amp;search_page_no=1&amp;search_rank=1&amp;search_sig=8b2d8420f7916adb6665a06be13cc219&amp;ref=heavyblogisheavy.com">Svart lerret</a> (black metal)</p><p><a>Talia Hoit &#x2013; </a><a href="https://taliahoit.bandcamp.com/album/when-the-skies-fall?ref=heavyblogisheavy.com">When The Skies Fall</a> (symphonic metal)</p><p>Thomas Roese &#x2013; <a href="https://thomasroeseofficial.bandcamp.com/album/the-human-i-never-became?from=search&amp;search_item_id=654262499&amp;search_item_type=a&amp;search_match_part=%3F&amp;search_page_id=5687989835&amp;search_page_no=1&amp;search_rank=1&amp;search_sig=78e8db7a50b60d6521295e7b28f05fe8&amp;ref=heavyblogisheavy.com">The Human I Never Became</a> (post-metal)</p><p>Torturous Inception &#x2013; <a href="https://www.youtube.com/watch?v=eEJciunjz5k&amp;ref=heavyblogisheavy.com">Life&#x2019;s Worth</a> (brutal death metal)</p><p><a>Totalit&#xE4;r &#x2013; </a><a href="https://totalitaer.bandcamp.com/album/s-t?ref=heavyblogisheavy.com">Totalit&#xE4;r</a> (crust punk)</p><h3 id="triosphere-%E2%80%93-oceans-above-stars-below-heavyprog-metal">Triosphere &#x2013; <em>Oceans Above, Stars Below </em>(heavy/prog metal) </h3><figure class="kg-card kg-embed-card"><iframe width="200" height="113" src="https://www.youtube.com/embed/iO2aEdzRqeg?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="Triosphere - &quot;Oceans Above, Stars Below&quot; - Official Music Video"></iframe></figure><p>Turnstile &#x2013; <a href="https://stereogum.com/2509027/turnstile-reimagine-never-enough-with-a-fascinating-crew-of-contributors/news?ref=heavyblogisheavy.com">Never Enough: Versions</a> (I guess)</p><p><a>Unholy Redeemer &#x2013; </a><a href="https://unholy-redeemer.bandcamp.com/album/journey-beyond-death?ref=heavyblogisheavy.com">Journey Beyond Death</a> (death metal)</p><p>Veneficus Sarcina &#x2013; <a href="https://veneficussarcina.bandcamp.com/album/veni-regina-mea?from=search&amp;search_item_id=3094558262&amp;search_item_type=a&amp;search_match_part=%3F&amp;search_page_id=5687989817&amp;search_page_no=1&amp;search_rank=1&amp;search_sig=56dd0d5bff823dda00cea602c8e36481&amp;ref=heavyblogisheavy.com">Veni regina mea</a> (blackened sludge)</p><p>Void Moon &#x2013; <a href="https://void-moon.bandcamp.com/album/the-runes-that-bind?from=search&amp;search_item_id=755833172&amp;search_item_type=a&amp;search_match_part=%3F&amp;search_page_id=5687989772&amp;search_page_no=1&amp;search_rank=1&amp;search_sig=4aa30e5d6537cc527088f652a22ac35c&amp;ref=heavyblogisheavy.com">The Runes That Bind</a> (doom)</p><p><a>Vordermann &#x2013; </a><a href="https://www.youtube.com/watch?v=3gbiM59ZY0A&amp;ref=heavyblogisheavy.com">Feeding On Fireworks</a> (stonery post/math-rock)</p><p><a>Wine Lips &#x2013; </a><a href="https://winelips.bandcamp.com/album/tv-dinner?ref=heavyblogisheavy.com">TV Dinner</a> (punk)</p><p><a>Xenith &#x2013; </a><a href="https://xenithband.bandcamp.com/album/to-no-avail?ref=heavyblogisheavy.com">To No Avail</a> (metal/deathcore)</p>";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}}}i:12;a:6:{s:4:"data";s:0:"";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";s:5:"child";a:4:{s:0:"";a:6:{s:5:"title";a:1:{i:0;a:5:{s:4:"data";s:24:"Mastodon – Marrow Deep";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:11:"description";a:1:{i:0;a:5:{s:4:"data";s:128:"Marrow Deep feels fresh and inspired, pushing forward once again when it felt like Mastodon had maybe run out of things to say. ";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"link";a:1:{i:0;a:5:{s:4:"data";s:65:"https://www.heavyblogisheavy.com/2026/08/28/mastodon-marrow-deep/";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"guid";a:1:{i:0;a:5:{s:4:"data";s:24:"6a8e474b2dd4b30001d53984";s:7:"attribs";a:1:{s:0:"";a:1:{s:11:"isPermaLink";s:5:"false";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:8:"category";a:2:{i:0;a:5:{s:4:"data";s:7:"Reviews";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:1;a:5:{s:4:"data";s:8:"Mastodon";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:7:"pubDate";a:1:{i:0;a:5:{s:4:"data";s:29:"Fri, 28 Aug 2026 06:12:21 GMT";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:32:"http://purl.org/dc/elements/1.1/";a:1:{s:7:"creator";a:1:{i:0;a:5:{s:4:"data";s:14:"Joshua Bulleid";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:29:"http://search.yahoo.com/mrss/";a:1:{s:7:"content";a:1:{i:0;a:5:{s:4:"data";s:0:"";s:7:"attribs";a:1:{s:0:"";a:2:{s:3:"url";s:104:"https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/08/unnamed.jpg";s:6:"medium";s:5:"image";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:40:"http://purl.org/rss/1.0/modules/content/";a:1:{s:7:"encoded";a:1:{i:0;a:5:{s:4:"data";s:12974:"<img src="https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/08/unnamed.jpg" alt="Mastodon &#x2013; Marrow Deep"><p>Arguably the defining metal band of their generation, <strong>Mastodon</strong> have never had a bad album, but their last four outings have been a significant step below the original classic four records that put them on the map. Beginning with the simultaneously simplified yet unfocused and maybe misguided <em>The Hunter </em>in 2011 and ending with the surprisingly successful and deeply personal, yet somehow forgettable double album <em>Hushed and Grim </em>(2021), the second chapter of Mastodon&apos;s career has been characterised by paradoxical inconsistencies. Although the band continued to push themselves with new concepts and textures, it also seemed like they&apos;d fallen into something of a reliable holding pattern, emerging every few years to deliver something comfortingly yet never that excitingly Mastodon sounding. <em>Marrow Deep</em>, therefore, represents the beginning of a new chapter for Mastodon,* and presents an opportunity for the band to refresh and re-establish themselves, which they have taken to wholeheartedly. </p><p>Whatever you think of the albums in between, it&apos;s hard to deny that <em>Marrow Deep </em>is the best Mastodon<strong> </strong>album since <em>Once More &apos;round the Sun </em>(2014)&#x2014;or even longer, for (silly) people who don&apos;t like that album for whatever reason. The record continuously conjures up the Mastodonian triumphs of their past, with its overall sonic palette and songwriting sensibilities are something of a mix between what are perhaps the band&apos;s two greatest triumphs in <em>Blood Mountain </em>(2006) and <em>Crack the Skye </em>(2009). Even then though, it sounds less like a rehash or a missing link than something like what <em>Emperor of Sand</em> (2017) could and maybe should have been, in its masterful blend of classic and continuous Mastodon sounds.</p><p>There are also a few new elements in play. Along with the added keyboards and emphasis on more traditional prog rock textures, &quot;In the Ruins&quot; represents something of a progressive metal Ouroboros, sounding like the sort of song <strong>Baroness </strong>have been ending their shows with since 2012, while &quot;A Vampire&apos;s Demeanor&quot; (featuring <strong>Lamb of God</strong>&apos;s Randy Blythe and <strong>Converge</strong>&apos;s Nate Newton) is an almost nu metal sounding song that joins <strong>Meshuggah</strong>&apos;s &quot;Monstro-City&quot; as perhaps one of the finest modern examples of the genre. This is also the first time Mastodon are working with <strong>Converge</strong>&apos;s <strong>Kurt Ballou</strong> and co-producer <strong>Patrik Berger</strong>, who is mostly known for co-writing <strong>Robyn</strong>&apos;s &quot;Dancing on my Own&quot; and a bunch of <strong>Charli XCX </strong>songs. Neither producer&apos;s trademark sound is really present though, with both combining instead into a perfect balance of metallic crunch and progressive clarity.</p><figure class="kg-card kg-embed-card"><iframe width="200" height="113" src="https://www.youtube.com/embed/pQ65pizgD9I?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="Mastodon - Your Ghost Again (Official Visual)"></iframe></figure><p><em>Marrow Deep </em>is, of course, the first Mastodon album without iconic founding guitarist Brent Hinds, who was ejected from the band last year, amid what appear to be <a href="https://youtu.be/Ba4fW0mXh_w?ref=heavyblogisheavy.com" rel="noreferrer">increasingly troubling circumstances</a>, before dying in a motorcycle accident a few months later. Hinds has since been replaced by Canadian guitarist <strong>Nick Johnston</strong>, whose work I am not familiar with, but who seems to be a good fit. In fact, Johnston does such a good job of fitting in that it&apos;s hard to really tell if he&apos;s there at all&#x2014;whether he does such a good job of blending in with the rest of the band, or if he wasn&apos;t really that involved in the album&apos;s composition and is simply playing parts written with Hinds in mind. Conversely, Hinds&apos; absence, while not necessarily damaging, is certainly noticeable. There are plenty of killer leads across the record, but none of them rip or ripple with the kind of fire he brought to the table. While he was certainly the least-accomplished of the three Mastodon vocalists, the absence of Hinds&apos; distinctively garbled voice somewhat diminishes the album&apos;s dynamics, with Troy Sanders solidifying himself as the band&apos;s dedicated vocalist and Brann Dailor only really brought in as an added flavour here or there. You can hear the parts where Hinds&apos; might have come in, and it makes you wonder what <em>Marrow Deep</em> might have been if he had continued on with the band instead.</p><p>During this shake-up, Mastodon also took the opportunity to officially induct into their ranks Brazilian keyboardist Jo&#xE3;o Nogueira, who has been collaborating with the band since 2021 and also plays in <strong>The Claypool Lennon Delirium</strong>. Unlike Johnston, Nogueira&apos;s contributions are immediately noticeable and largely elevating. Rather than dominating the album&apos;s atmosphere, his key sections are more often brought in as little flourishes during bridge and lead sections, that add such an exciting and distinctly &quot;progressive&quot; air to proceedings that it&apos;s a wonder Mastodon didn&apos;t introduce him or another keyboardist sooner. </p><p>Unfortunately, while he might be a perfect sonic fit for the band, his personal associations raise some serious concerns. Outside of music, Nogueira has a longstanding association with conservative/right-wing, <a href="https://web.archive.org/web/20200504010819/https://www.cafehistoria.com.br/negacionismo-historico-historiografia/" rel="noreferrer">historical &quot;revisionist&quot; </a>organisation <a href="https://en.wikipedia.org/wiki/Brasil_Paralelo?ref=heavyblogisheavy.com">Brasil Paralelo</a>, where he goes by the name <a href="https://pt-wikipedia-org.translate.goog/wiki/Rasta?_x_tr_sl=pt&amp;_x_tr_tl=en&amp;_x_tr_hl=en&amp;_x_tr_pto=sc&amp;ref=heavyblogisheavy.com" rel="noreferrer">&quot;Rasta&quot;</a> and hosts a sort of <em>Daily Show</em>-style comedy show. I don&apos;t speak Portuguese, so I can&apos;t comment on what he&apos;s actually saying in these videos, but&#x2014;given Brasil Paralelo&apos;s associations with the rise of modern, neo-facisim, and their <a href="https://web.archive.org/web/20190418211253/https://www.cartacapital.com.br/opiniao/para-quem-serve-o-nosso-conhecimento/" rel="noreferrer">documented defenses</a> and conspiracy theories about things like colonialism, slavery, sexism, homophobia and more&#x2014;it&apos;s probably not good and certainly isn&apos;t being published somewhere that is. Hinds certainly had <a href="https://metalinjection.net/news/drama/mastodon-apologize-for-brent-hinds-use-of-homophobic-language-have-no-ill-will-towards-disturbed?ref=heavyblogisheavy.com" rel="noreferrer">his own problems</a>, but there&apos;s a big difference between personal gripes and uncoothness and being a mouthpiece for an institutionalised and (somewhat) influential right-wing conspiracy-spreading organisation. As far as I know, Mastodon have not addressed Nogueira&apos;s involvement with Brasil Paralelo in any interviews or other press material, and it is unclear whether they are aware of, or aware of the extent to which he serves as a spreader of their harmful, right-wing rhetoric, but I&#x2014;and I&apos;m sure many other Mastodon fans&#x2014;are very interested to see how they respond once it is brought up.</p><figure class="kg-card kg-embed-card"><iframe width="200" height="113" src="https://www.youtube.com/embed/94Cr7eKDZbA?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="Mastodon - Snakes For Dinner (Official Video)"></iframe></figure><p>Additionally, for all its brilliant excesses, there&apos;s one other thing clearly missing from <em>Marrow Deep</em>, and that&apos;s big, fat, fuck-off riffs. The band&apos;s trademark, wiry guitar leads are on full display, and there are plenty of killer moments to be had throughout the songs&#x2014;often simultaneously&#x2014;but there&apos;s no &quot;March of the Fire Ants&quot;, &quot;Blood and Thunder&quot;, &quot;High Road&quot; or &quot;Curl of the Burl&quot; here, and hardly a &quot;Wolf is Loose&quot;, &quot;Oblivion&quot;, &quot;Teardrinker&quot; or &quot;Sultan&apos;s Curse&quot; either. Lead single &quot;Your Ghost Again&quot; is clearly the album&apos;s standout song, though that has far more to do with its luscious progressive layering and vocal melodies than the force of its six-string savagery. Opener &quot;Barbarians Blood&quot; lumbers rather than roars in, and while &quot;Out like a Lamb&quot; perhaps comes closest to becoming a classic Mastodon rocker, it&apos;s more in the &quot;Spectrelight&quot; style of anachronistic throwbacks than its own, definitive statement. Maybe its the lack of Hinds&apos; contributions to its composition, but&#x2014;as good as they all are&#x2014;none of <em>Marrow Deep</em>&apos;s tracks announce themselves in the way the true Mastodon classics do.</p><p>The other, arguably minor&#x2014;but also rather unnecessary&#x2014;weakness of <em>Marrow Deep</em> is its length. Mastodon have never been ones for short record lengths, with most of their outings sitting around the 50-minute mark. Considering the complexity of their compositions though, this length usually makes for a surprising and rewardingly concise experience, especially when it comes to something like <em>Crack the Skye</em>. At 65 minutes, <em>Marrow Deep </em>is easily Mastodon&apos;s longest, single-disc experience and you definitely feel it. What&apos;s more, the responsibility for this arguably bloated longevity lies squarely on superfluous final outing &quot;The Three Fates.&quot; The album already had something of a false/elongated ending with &quot;A Vampire&apos;s Demeanor,&quot; which provided a perfectly natural climax, before &quot;The Vanishing&quot; comes slinking in for one more round. Here, the encore presentation works perfectly, with the very &quot;Planet Caravan&quot;-sounding track &#x2014;which features the actual <strong>Black Sabbath</strong>&apos;s Geezer Butler, alongside <strong>Gojira</strong>&apos;s Joe Duplantier&#x2014;adding a natural and fitting epilogue to proceedings, whose spaced-out sounds allow the listener time to &quot;come down&quot; and reflect on the journey they&apos;ve just been on&#x2014;only to have &quot;Three Fates&quot; come crashing in again and ruin the whole effect, only to awkwardly end on a random riff that comes out of nowhere and simply stops suddenly. The song itself isn&apos;t bad and worth it on its own just to hear <strong>Clutch</strong>&apos;s Neil Fallon carrying on like a mad preacher, but I&apos;d definitely say its the weakest track on here though and not nearly as suitable for closing the record as the two tracks before it, and might have worked better earlier on in the album.** As is, however, it feels tacked on and an instance of over-egging the progressive pudding.</p><p><em>Marrow Deep </em>is an album that asks a lot of its listeners, as the last couple Mastodon albums have as well. Unlike its immediate predecessors though, <em>Marrow Deep </em>feels fresh and inspired, pushing forward once again when it felt like Mastodon had maybe run out of things to say. While it sounds distinctly like Mastodon, it also sounds like a band who are still hungry and aren&apos;t satisfied to rest on their laurels the way they arguably have been for a while now. Get a few more riffs in there, cut down on the length and sort out the whole keyboardist situation, and they might yet be capable of delivering another definitive classic.</p>
<!--kg-card-begin: html-->
<iframe style="border: 0; width: 100%; height: 120px;" src="https://bandcamp.com/EmbeddedPlayer/album=3653801622/size=large/bgcol=333333/linkcol=e99708/tracklist=false/artwork=small/transparent=true/" seamless><a href="https://mastodon.bandcamp.com/album/marrow-deep?ref=heavyblogisheavy.com">Marrow Deep by Mastodon</a></iframe>
<!--kg-card-end: html-->
<p>*Take a shot every time someone writes that while reviewing this album.</p><p>**Due to promo streaming&apos;s penchant for playing final tracks second when listening on mobile for some reason, I can confirm it does indeed work quite well as the second rather than final track.</p>";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}}}i:13;a:6:{s:4:"data";s:0:"";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";s:5:"child";a:4:{s:0:"";a:6:{s:5:"title";a:1:{i:0;a:5:{s:4:"data";s:67:"EXCLUSIVE PREMIERE: Winter At Sea Show You Their &quot;Hearts&quot;";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:11:"description";a:1:{i:0;a:5:{s:4:"data";s:219:"This kind of post-rock, for me, these days, either speaks to me in this fashion or not at all. And Winter At Sea do, piercing me to the core with their deft approach to sorrow, memory, persistence, and hard-won triumph.";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"link";a:1:{i:0;a:5:{s:4:"data";s:99:"https://www.heavyblogisheavy.com/2026/08/27/exclusive-premiere-winter-at-sea-show-you-their-hearts/";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"guid";a:1:{i:0;a:5:{s:4:"data";s:24:"6a90542e321ef100015dccc9";s:7:"attribs";a:1:{s:0:"";a:1:{s:11:"isPermaLink";s:5:"false";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:8:"category";a:2:{i:0;a:5:{s:4:"data";s:9:"Premieres";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:1;a:5:{s:4:"data";s:13:"Winter At Sea";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:7:"pubDate";a:1:{i:0;a:5:{s:4:"data";s:29:"Thu, 27 Aug 2026 16:00:12 GMT";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:32:"http://purl.org/dc/elements/1.1/";a:1:{s:7:"creator";a:1:{i:0;a:5:{s:4:"data";s:15:"Eden Kupermintz";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:29:"http://search.yahoo.com/mrss/";a:1:{s:7:"content";a:1:{i:0;a:5:{s:4:"data";s:0:"";s:7:"attribs";a:1:{s:0:"";a:2:{s:3:"url";s:135:"https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/08/Winter-At-Sea---Hearts---Digital-Cover.jpg";s:6:"medium";s:5:"image";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:40:"http://purl.org/rss/1.0/modules/content/";a:1:{s:7:"encoded";a:1:{i:0;a:5:{s:4:"data";s:2794:"<img src="https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/08/Winter-At-Sea---Hearts---Digital-Cover.jpg" alt="EXCLUSIVE PREMIERE: Winter At Sea Show You Their &quot;Hearts&quot;"><p>I&apos;ve said it before and I will say it again: it takes a lot to get me interested in &quot;classic&quot; post-rock these days. I won&apos;t rehash my complaints here but suffice it to say that I think that thirty odd years of build ups and crescendos is more than enough. And yet, there are still bands operating within the space who have, for lack of a better word, &quot;the juice&quot;. Even if the track structures are not exactly revolutionary, the passion and drive of the group makes the good ol&apos; formula beat with invigorated force. <strong>Winter At Sea</strong> is a phenomenal example. Made up of members from other blog-favored groups (like <strong>Flies Are Spies From Hell</strong> and <strong>Din Of Celestial Birds</strong>), their music is steeped with a sense of melancholic loss and dogged hope that I find hard to resist. Head on down to listen to <em>Hearts</em> below to see what I mean.</p>
<!--kg-card-begin: html-->
<iframe style="border: 0; width: 100%; height: 120px;" src="https://bandcamp.com/EmbeddedPlayer/album=1668821246/size=large/bgcol=ffffff/linkcol=0687f5/artwork=small/transparent=true/tracklist=false/tracks=2675776959/esig=e7425b9e2f2afbc777ff6c7130c58075/" seamless><a href="https://winteratsea.bandcamp.com/album/hearts?ref=heavyblogisheavy.com">Hearts by Winter At Sea</a></iframe>
<!--kg-card-end: html-->
<p>Oh boy. <em>Hearts</em> is a one track, twenty minutes journey into the depths of a murky ocean or rather the decrepit structures that still eke out a life at its shore. The classic post-rock components are all there - the tremolo picked, delay-heavy guitars, the ponderous drums, the sonorous bass. Everything is likewise arranged into the classic post-rock structure, the slow build up and eventual catharsis of the five pieces contained within this one track/album. But something just <em>clicks</em>, you know? Like I said above, there is a <em>passion</em> here, a <em>drive</em>. It&apos;s not just familiar notes on a page or mechanical instructions being carried out. It&apos;s a <em>performance</em>.</p><p>As always, I can&apos;t really tell you why this works where other music like it doesn&apos;t. But I can <em>show</em> it you by playing the music itself. That&apos;s part of the beauty and challenge of music, right? It is unmediated. It speaks to us directly. Or not. This kind of post-rock, for me, these days, either speaks to me in this fashion or not at all. And Winter At Sea do, piercing me to the core with their deft approach to sorrow, memory, persistence, and hard-won triumph.</p>";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}}}i:14;a:6:{s:4:"data";s:0:"";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";s:5:"child";a:4:{s:0:"";a:6:{s:5:"title";a:1:{i:0;a:5:{s:4:"data";s:33:"The Anatomy Of: Perpetual Paradox";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:11:"description";a:1:{i:0;a:5:{s:4:"data";s:199:"Perpetual Paradox's new EP, May Misery Befall You, delivers a killer combination of Psycroptic, Rivers of Nihil, Lamb of God and Fit for an Autopsy, along with an array of other delicious influences.";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"link";a:1:{i:0;a:5:{s:4:"data";s:77:"https://www.heavyblogisheavy.com/2026/08/26/the-anatomy-of-perpetual-paradox/";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"guid";a:1:{i:0;a:5:{s:4:"data";s:24:"6a8c68931e9f170001e5d362";s:7:"attribs";a:1:{s:0:"";a:1:{s:11:"isPermaLink";s:5:"false";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:8:"category";a:9:{i:0;a:5:{s:4:"data";s:10:"Anatomy Of";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:1;a:5:{s:4:"data";s:17:"Perpetual Paradox";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:2;a:5:{s:4:"data";s:11:"Lamb of God";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:3;a:5:{s:4:"data";s:17:"Avenged Sevenfold";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:4;a:5:{s:4:"data";s:17:"Killswitch Engage";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:5;a:5:{s:4:"data";s:9:"Metallica";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:6;a:5:{s:4:"data";s:11:"Lorna Shore";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:7;a:5:{s:4:"data";s:29:"synestia & disembodied tyrant";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}i:8;a:5:{s:4:"data";s:18:"Infant Annihilator";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:7:"pubDate";a:1:{i:0;a:5:{s:4:"data";s:29:"Wed, 26 Aug 2026 16:00:44 GMT";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:32:"http://purl.org/dc/elements/1.1/";a:1:{s:7:"creator";a:1:{i:0;a:5:{s:4:"data";s:14:"Joshua Bulleid";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:29:"http://search.yahoo.com/mrss/";a:1:{s:7:"content";a:1:{i:0;a:5:{s:4:"data";s:0:"";s:7:"attribs";a:1:{s:0:"";a:2:{s:3:"url";s:136:"https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/08/Perpetual-Paradox-May-Misery-Befall-You.jpg";s:6:"medium";s:5:"image";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:40:"http://purl.org/rss/1.0/modules/content/";a:1:{s:7:"encoded";a:1:{i:0;a:5:{s:4:"data";s:9071:"<img src="https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/08/Perpetual-Paradox-May-Misery-Befall-You.jpg" alt="The Anatomy Of: Perpetual Paradox"><p>You might not have heard of London&apos;s <strong>Perpetual Paradox</strong>, but you should definitely give them a listen. Although ostensibly a groove-laden death-thrash/core outfit, there&apos;s a lot more going on here than that already enticing description might suggest. The 5 tracks on their new EP <em>May Misery Befall You </em>deliver a killer combination of wiry, off-kilter lead-work that reminds me of <strong>Psycroptic</strong> (except without the <a href="https://www.heavyblogisheavy.com/2026/07/17/release-roundup-7-17-26/" rel="noreferrer">Nazi merch</a>) along with and added progressiveness &#xE0; la <strong>Rivers of Nihil</strong>, the crunch of <strong>Lamb of God </strong>and brutality of <strong>Fit for an Autopsy</strong>. It&apos;s a potent concoction to be sure and one of the more exciting &quot;new&quot; artists I&apos;ve come across this year. Check out their ferocious &quot;Source of Hate&quot; below, and keep reading to see what other ingredients go into making such a devastatingly delicious sound.</p><figure class="kg-card kg-embed-card"><iframe width="200" height="113" src="https://www.youtube.com/embed/oxdTp4F7yWc?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="Perpetual Paradox - Source Of Hate"></iframe></figure><h2 id="jorge-guitar">Jorge (Guitar)</h2><p><strong>Lamb of God</strong> was definitely the band that made me realise I absolutely love groove. I used to stay awake on Sunday nights to watch MTV&apos;s <em>Headbanger&#x2019;s Ball </em>and when I first heard &quot;Set To Fail&quot; there, it absolutely made me go crazy!The riff, the aggressiveness, the drums, the vocals&#x2026;I was like &#x201C;I wanna write shit like this&#x201D;!From thrash to metalcore and later on deathcore, groove was always what got me hyped with metal.&#xA0;Mark Morton and Will Adler are absolute riff beats and were a major influence in my playing style!</p><figure class="kg-card kg-embed-card"><iframe width="200" height="113" src="https://www.youtube.com/embed/E813VYySueM?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="Lamb of God - Set to Fail"></iframe></figure><h2 id="adrian-vocals">Adrian (Vocals)</h2><p>For me it goes back to when I was just a teenager, listening to what everyone else was listening to, trying to figure out life. Then one friend showed me &quot;A Little Piece of Heaven&quot; by <strong>Avenged Sevenfold</strong>, and the spark was lit.That song was on repeat day and night. The theme, orchestras, trumpets and vocals were unlike anything I had heard before. It made me realise heavy music could be so much more than just guitars, bass and drums, and that atmosphere and arrangement could be just as important as the riffs. That&#x2019;s probably why on most Perpetual Paradox tunes, whenever there&#x2019;s orchestras or samples, I&#x2019;m usually behind them, or at least have been involved.</p><figure class="kg-card kg-embed-card"><iframe width="200" height="150" src="https://www.youtube.com/embed/KVjBCT2Lc94?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="Avenged Sevenfold - A Little Piece Of Heaven [Official Music Video]"></iframe></figure><p>&quot;My Curse&quot; by <strong>Killswitch Engage</strong> made me want to pursue vocals. I became obsessed with the contrast between warm, melodic vocals and brutal screams. Howard Jones&#x2019; vocals were out of this world and I remember thinking, &#x201C;fuck, I wish I could sound like that.&#x201D; I already liked singing when I was alone&#x2014;doing chores, in the shower&#x2014;so I started taking it seriously and kept gaining the confidence to develop my chops.</p><figure class="kg-card kg-embed-card"><iframe width="200" height="150" src="https://www.youtube.com/embed/iPW9AbRMwFU?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="Killswitch Engage - My Curse [OFFICIAL VIDEO]"></iframe></figure><p>Then came the 2020s deathcore era. Bands like <strong>Lorna Shore</strong>, or songs like &quot;Death Empress&quot; by <strong>Disembodied Tyrant/Synestia</strong>, changed how I looked at heavy music. I loved the filthy breakdowns, while <strong>Sleep Token</strong> became a huge anchor for the clean, atmospheric side of my vocals. Combining that beautiful, warm voice with something fucking disgusting is probably one of the biggest things that shaped how I write for Perpetual Paradox today.</p><figure class="kg-card kg-embed-card"><iframe width="200" height="113" src="https://www.youtube.com/embed/N4N58uzzrj0?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="DISEMBODIED TYRANT/SYNESTIA - DEATH EMPRESS (OFFICIAL VIDEO)"></iframe></figure><h2 id="ollie-guitar">Ollie (Guitar)</h2><p>For a long time I didn&#x2019;t really listen to music because I couldn&#x2019;t find anything I liked. But then a friend showed me <strong>Metallica</strong>&#x2019;s <em>Ride the Lightning</em> (1985) and everything changed. I dove headfirst into the macabre world of metal, not long after which I discovered its more extreme genres and the bands behind them, like <strong>Death</strong> and <strong>The Black Dahlia Murder</strong>.&#xA0;</p><figure class="kg-card kg-embed-card"><iframe width="200" height="150" src="https://www.youtube.com/embed/DVOImtJY7po?list=OLAK5uy_k4yeBNbCJLDBeqj_QsTlpRoncOxmGLQDo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></figure><p>Although a thrasher at heart, I branched out early, in doing so discovering the genres and bands that would define what I listen to and write now: <strong>Bleed from Within</strong>, <strong>Lorna Shore</strong>, <strong>August Burns Red</strong>, <strong>Fit for an Autopsy</strong>, and <strong>Decapitated</strong>, to name a few. I try not to let myself stick to one genre as it&#x2019;s a detriment and a waste to do so, so anything I think sounds good, I&#x2019;ll listen to and find a way to emulate in my own music. More recently I&#x2019;ve been getting into bands like <strong>Nails</strong>, <strong>Converge</strong> and <strong>End</strong>, which has had a notable impact on how I write and approach the equipment I use to do so. I think I&#x2019;m far from done discovering and learning about metal and I&#x2019;m loving how it&#x2019;s shaping the music I write for Perpetual Paradox.</p><figure class="kg-card kg-embed-card"><iframe width="200" height="113" src="https://www.youtube.com/embed/OEicHBvqd2Y?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="FIT FOR AN AUTOPSY - Far From Heaven (OFFICIAL MUSIC VIDEO)"></iframe></figure><h2 id="harry-drums">Harry (Drums)</h2><p>As much as I&#x2019;d love to write about my musical upbringing, I don&#x2019;t think many people would take much interest in the finer details, so here&apos;s the top line. My favourite bands, and the bands that really got me to where I am today, include <strong>Slipknot</strong>, <strong>PeelingFlesh</strong>, <strong>Deathgrips</strong>, <strong>Chelsea Grin</strong>, <strong>Thy Art is Murder</strong>, <strong>Korn</strong>, <strong>Primus</strong> and <strong>Infant Annihilator</strong>. To anyone who hasn&apos;t checked out the drummers in these bands, please do, and you&#x2019;ll know exactly why I play the way I do. Simply put, the bands and music I was brought up on have taught me everything I know: Hit hard, be aggressive and treat your snare like it owes you money &#x2026;mine still hasn&#x2019;t paid me yet.</p><figure class="kg-card kg-embed-card"><iframe width="200" height="113" src="https://www.youtube.com/embed/SImHi16cwqc?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="Infant Annihilator - Cuntcrusher - Drum Play-through [OFFICIAL] [HD]"></iframe></figure>";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}}}}}s:27:"http://www.w3.org/2005/Atom";a:1:{s:4:"link";a:1:{i:0;a:5:{s:4:"data";s:0:"";s:7:"attribs";a:1:{s:0:"";a:3:{s:4:"href";s:37:"https://www.heavyblogisheavy.com/rss/";s:3:"rel";s:4:"self";s:4:"type";s:19:"application/rss+xml";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}}}}}}}}}}s:4:"type";i:128;s:7:"headers";a:25:{s:4:"date";s:29:"Sun, 13 Sep 2026 23:09:54 GMT";s:12:"content-type";s:34:"application/rss+xml; charset=utf-8";s:14:"content-length";s:5:"43894";s:4:"etag";s:37:"W/"24780-C1MnGwYYWxwr+7Q8tcjFHauf+pQ"";s:6:"server";s:10:"cloudflare";s:13:"cache-control";s:17:"public, max-age=0";s:6:"status";s:6:"200 OK";s:16:"content-encoding";s:4:"gzip";s:3:"via";s:37:"1.1 varnish, 1.1 varnish, 1.1 varnish";s:13:"accept-ranges";s:5:"bytes";s:3:"age";s:6:"212969";s:11:"x-served-by";s:101:"cache-ams-eham8680049-AMS, cache-ams-eham8680049-AMS, cache-ams-eham8680039-AMS, cache-cmh1290027-CMH";s:7:"x-cache";s:14:"MISS, HIT, HIT";s:12:"x-cache-hits";s:8:"0, 60, 0";s:7:"x-timer";s:26:"S1789340995.942421,VS0,VE2";s:4:"vary";s:23:"Cookie, Accept-Encoding";s:12:"x-request-id";s:36:"514c1c87-0c8e-4c3a-b87c-3e88034e9c92";s:12:"ghost-fastly";s:15:"true;production";s:7:"alt-svc";s:17:"h3=:443; ma=86400";s:15:"cf-cache-status";s:7:"DYNAMIC";s:25:"strict-transport-security";s:9:"max-age=0";s:13:"server-timing";s:55:"cfCacheStatus;desc=DYNAMIC, cfEdge;dur=8,cfOrigin;dur=4";s:9:"report-to";s:245:"{group:cf-nel,max_age:604800,endpoints:[{url:https://a.nel.cloudflare.com/report/v4?s=1WdQ9w3ZjH3RB2iAF9KTupTalmtzTJzXcLhX1CI%2FzLdsriUUjqoIv8FdDqovsCYAwYrdsy%2BlL%2BT%2BzBmER12vtx3qsgQMLu5iJjB6vITGAkaP38TEGAG5CJc%2FNpq0xIr7RSuijGZe2cpVAlk%3D}]}";s:3:"nel";s:54:"{report_to:cf-nel,success_fraction:0.0,max_age:604800}";s:6:"cf-ray";s:20:"a3aad2825805122e-CMH";}s:5:"build";i:1788965037;s:13:"cache_version";i:1;s:4:"hash";s:40:"740322fc8fcc3f7b2cb7761b42bc9292a6ad7c31";s:21:"cache_expiration_time";i:1789341794;s:23:"__cache_expiration_time";i:1789341794;}