licit";b:0;s:8:"xml_lang";s:0:"";}}}s:29:"http://search.yahoo.com/mrss/";a:1:{s:7:"content";a:1:{i:0;a:5:{s:4:"data";s:0:"";s:7:"attribs";a:1:{s:0:"";a:2:{s:3:"url";s:111:"https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/09/a0410474614_10.jpg";s:6:"medium";s:5:"image";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:40:"http://purl.org/rss/1.0/modules/content/";a:1:{s:7:"encoded";a:1:{i:0;a:5:{s:4:"data";s:30061:"<h2 id="top-picks">Top Picks</h2><h3 id="judiciary-%E2%80%93-stalagmite-angels-metallic-hardcore-groove-thrash">Judiciary &#x2013; <em>Stalagmite Angels</em> (metallic hardcore, groove thrash) </h3><img src="https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/09/a0410474614_10.jpg" alt="Release Roundup: 9/4/26"><p>You ever see <a href="https://www.metal-archives.com/images/3/5/4/0/3540382449_photo.jpg?0725&amp;ref=heavyblogisheavy.com" rel="noreferrer"><strong>Gatecreeper</strong></a><strong>,</strong> and they&#x2019;re like four skinny hardcore dudes and then there&apos;s the guitarist, who&#x2019;s this big death metal guy who&#x2019;s a head taller than everyone, weighs more than the rest of them combined and absolutely shits riffs? Judiciary are what you get if he was all the other members as well.&#xa0; </p><figure class="kg-card kg-embed-card"><iframe width="200" height="113" src="https://www.youtube.com/embed/juKGdo76UHE?feature=oembed" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen title="Judiciary - Death Knell (Official Video)"></iframe></figure>
