a:8:{s:5:"child";a:1:{s:0:"";a:1:{s:3:"rss";a:1:{i:0;a:6:{s:4:"data";s:0:"";s:7:"attribs";a:1:{s:0:"";a:1:{s:7:"version";s:3:"2.0";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";s:5:"child";a:1:{s:0:"";a:1:{s:7:"channel";a:1:{i:0;a:6:{s:4:"data";s:0:"";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";s:5:"child";a:2:{s:0:"";a:8:{s:5:"title";a:1:{i:0;a:5:{s:4:"data";s:19:"Heavy Blog is Heavy";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:11:"description";a:1:{i:0;a:5:{s:4:"data";s:35:"Documenting the Golden Age of Metal";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"link";a:1:{i:0;a:5:{s:4:"data";s:33:"https://www.heavyblogisheavy.com/";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:5:"image";a:1:{i:0;a:6:{s:4:"data";s:0:"";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";s:5:"child";a:1:{s:0:"";a:3:{s:3:"url";a:1:{i:0;a:5:{s:4:"data";s:44:"https://www.heavyblogisheavy.com/favicon.png";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:5:"title";a:1:{i:0;a:5:{s:4:"data";s:19:"Heavy Blog is Heavy";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"link";a:1:{i:0;a:5:{s:4:"data";s:33:"https://www.heavyblogisheavy.com/";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}}}}s:9:"generator";a:1:{i:0;a:5:{s:4:"data";s:10:"Ghost 6.65";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:13:"lastBuildDate";a:1:{i:0;a:5:{s:4:"data";s:29:"Mon, 28 Sep 2026 14:01:06 GMT";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:3:"ttl";a:1:{i:0;a:5:{s:4:"data";s:2:"60";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"item";a:15:{i:0;a:6:{s:4:"data";s:0:"";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";s:5:"child";a:4:{s:0:"";a:6:{s:5:"title";a:1:{i:0;a:5:{s:4:"data";s:24:"Endspace - First Contact";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:11:"description";a:1:{i:0;a:5:{s:4:"data";s:76:"Whatever is contained within First Contact, it's going to be alien as hell. ";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"link";a:1:{i:0;a:5:{s:4:"data";s:67:"https://www.heavyblogisheavy.com/2026/09/28/endspace-first-contact/";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:4:"guid";a:1:{i:0;a:5:{s:4:"data";s:24:"6ab9527983892a0001ebbe89";s:7:"attribs";a:1:{s:0:"";a:1:{s:11:"isPermaLink";s:5:"false";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:8:"category";a:1:{i:0;a:5:{s:4:"data";s:7:"Reviews";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}s:7:"pubDate";a:1:{i:0;a:5:{s:4:"data";s:29:"Mon, 28 Sep 2026 14:00:56 GMT";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:32:"http://purl.org/dc/elements/1.1/";a:1:{s:7:"creator";a:1:{i:0;a:5:{s:4:"data";s:17:"Mitchell Connolly";s:7:"attribs";a:0:{}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:29:"http://search.yahoo.com/mrss/";a:1:{s:7:"content";a:1:{i:0;a:5:{s:4:"data";s:0:"";s:7:"attribs";a:1:{s:0:"";a:2:{s:3:"url";s:103:"https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/09/109374.jpg";s:6:"medium";s:5:"image";}}s:8:"xml_base";s:0:"";s:17:"xml_base_explicit";b:0;s:8:"xml_lang";s:0:"";}}}s:40:"http://purl.org/rss/1.0/modules/content/";a:1:{s:7:"encoded";a:1:{i:0;a:5:{s:4:"data";s:3652:"<img src="https://storage.ghost.io/c/8b/c6/8bc603be-b831-44f6-8ffb-773be5bd45c8/content/images/2026/09/109374.jpg" alt="Endspace - First Contact"><p>040118180514 and 102119200914. No, these aren&apos;t the result of my cat stepping on my keyboard; they&apos;re pseudonyms for the members of <strong>Endspace</strong>, an experimental black metal duet hailing from Canada, who have been constantly reinforcing their &quot;sci-fi black metal&quot; sound through a trail of releases leading up to their debut record&#x2014;or &quot;transmission&quot;, per the record&apos;s pattern of naming each song as a sequential broadcast. Whatever is contained within <em>First Contact</em>, it&apos;s going to be alien as hell. </p><p>As predicted, <em>First Contact </em>is hypnotizingly strange. Dissonant metal genres are already on another plane of disorientation, but Endspace ramp the perplexity up tenfold, via the myriad synths, electronics, and vocoders at the duo&apos;s disposal, mostly implemented in their &quot;singing&quot;. 040... and 120...&apos;s vocals genuinely sound like extraterrestrial communications. After thirty-nine minutes however, the gimmick gets tiring. In fact, the second transmission alone exemplifies how overpowering their incomprehensible &quot;vocals&quot; can be. Across the nine transmissions, the &quot;vocals&quot; range from the pitch of a dog whistle to murky, gurgly depths, and once&#x2014;during &quot;Seventh Transmission&quot;&#x2014;can you pick up a robot warning the &quot;system engaged.&quot; Everything, including that excerpt, is also always too loud for whatever mood <em>First Contact </em>is currently in, with zero instrumental tracks providing a much-desired break. &quot;Ninth Transmission&quot;, is a particular offender, being constructed in a repeating calm/harsh pattern, and the recurring blasts have a high chance of blowing an eardrum or two.</p><p>It sucks, because underneath the alien mess that are the vocals, Endspace play commendable dissonant and technical black metal. The streak from the &quot;Seventh&quot; to &quot;Ninth&quot; transmissions, plus the chug-centered niceness that is &quot;Third Transmission&quot;, all feature guitar-forward, chaotic deliciousness, whose overhaul of electronics donates a symphonic feel to the record. This helps the otherworldly atmospheres, with the positively overpowering climax of &quot;Fourth Transmission&quot; providing the pinnacle of symphonics. Elsewhere, keyboard lines sound like opera notes and any synth undertone majorly assists any song it&apos;s found in. The tracks without a metal attitude, however, leave room for the aforementioned annoyances that are the vocals. The &quot;Second&quot;, &quot;Fifth&quot;, and &quot;Sixth&quot; transmissions are the definite weak spots in <em>First Contact</em>, with the fifth leaning too much into a noisy electronic beat.</p><p>While the execution of <em>First Contact </em>was as experimental and wacky as I hoped it&apos;d be, I bit off way more than I could chew with this LP. Tinny, vocoded emanations bury rather pleasing metal, resulting in a listen that I&apos;m not anticipating returning to anytime soon, and doesn&apos;t further my desire for Endspace to make a second acquaintance. </p>
